SUPABASE_URL=https://offrqlnhsfmrzwfszhav.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Owner of repos created for "new_project" tickets.
GITHUB_OWNER=Potatoe415

# Optional overrides
# PROJECTS_ROOT=C:\Users\rfaucompret\Documents\DEV\dev-projects
# RUNNER_SCRIPT=C:\Users\rfaucompret\Documents\DEV\dev-projects\autoclick\run_headless.ps1
# RUNNER_ENGINE=claude
# RUNNER_TIMEOUT_MIN=180
# COMMAND_TIMEOUT_MIN=15
# MAX_VERIFY_ATTEMPTS=2
# POLL_INTERVAL_SEC=300
# RUN_FOR_HOURS=12

# Runner: "node" (default) drives Claude Code with --output-format stream-json for the live journal;
# "script" falls back to RUNNER_SCRIPT (run_headless.ps1, plain text output).
# RUNNER_MODE=node
# CLAUDE_BIN=claude

# Dashboard base URL, used for links in PR descriptions and notifications.
# DASHBOARD_URL=https://simple-jira.example.vercel.app

# Push notifications (ntfy-style topic URL: the worker POSTs a short text with Title/Tags/Click headers)
# on: PR ready, question waiting, failure, merged. A project's notify_url overrides it. Unset = no notification.
# Anyone who knows an ntfy.sh topic can read it: pick a long random topic name.
# NOTIFY_URL=https://ntfy.sh/<long-random-topic>

# Browser check of the Vercel preview (playwright-core + installed Edge/Chrome). 0 disables it for every project.
# BROWSER_CHECK=1
# BROWSER_CHANNEL=msedge
# Screenshots are kept locally here (outside any git repo) and uploaded to the private Storage bucket "ticket-screens".
# SCREENS_DIR=C:\Users\you\Documents\DEV\dev-projects\.simple-jira\screens
