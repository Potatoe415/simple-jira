{
  "name": "simple-jira",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @simple-jira/web dev",
    "build": "pnpm --filter @simple-jira/web build",
    "worker": "pnpm --filter @simple-jira/worker start",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
